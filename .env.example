# Kopieer dit bestand naar .env en vul je eigen waarden in.
# Maak een Azure App Registratie aan op https://portal.azure.com

AZURE_CLIENT_ID=jouw-client-id-hier
AZURE_CLIENT_SECRET=jouw-client-secret-hier
# Gebruik "common" voor persoonlijke Microsoft-accounts (@live.nl, @outlook.com, @hotmail.com)
AZURE_TENANT_ID=common

# Redirect URI moet overeenkomen met wat je hebt ingesteld in Azure
REDIRECT_URI=http://localhost:5000/callback

# Willekeurige geheime sleutel voor Flask sessies (verander dit!)
FLASK_SECRET_KEY=verander-dit-naar-een-veilige-willekeurige-string
