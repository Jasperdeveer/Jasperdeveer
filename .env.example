# Kopieer dit bestand naar .env en vul je eigen waarden in.
# Maak een Azure App Registratie aan op https://portal.azure.com

AZURE_CLIENT_ID=jouw-client-id-hier
AZURE_CLIENT_SECRET=jouw-client-secret-hier
# Gebruik "common" voor persoonlijke Microsoft-accounts (@live.nl, @outlook.com, @hotmail.com)
AZURE_TENANT_ID=common

# Redirect URI moet overeenkomen met wat je hebt ingesteld in Azure
REDIRECT_URI=http://localhost:5000/callback

# Willekeurige geheime sleutel voor Flask sessies — genereer met:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=verander-dit-naar-een-veilige-willekeurige-string

# Op Railway: zet dit op /data/sessions (persistent volume)
# Lokaal: laat leeg (gebruikt ./sessions/ in de app-map)
SESSION_DIR=sessions

# Op Railway: zet dit op /data/spam_memory.db (persistent volume)
# Lokaal: laat leeg (gebruikt ./spam_memory.db in de app-map)
DATABASE_PATH=spam_memory.db

# Zet op "true" als de app achter HTTPS draait (Railway, Tailscale)
HTTPS_ONLY=false

# Sessieduur in uren (standaard 8)
SESSION_HOURS=8
