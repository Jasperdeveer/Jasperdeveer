PUID=1000
PGID=1000
TZ=Europe/Amsterdam

# Torbox account (Settings -> Integrations in je Torbox account)
TORBOX_EMAIL=
TORBOX_API_KEY=

# Doelmap in Dropbox voor de rclone-sync (al aangemaakt: /Jasper de Veer/Readarr-Library)
DROPBOX_REMOTE=dropbox:Jasper de Veer/Readarr-Library

# NordVPN "Service credentials" (niet je normale account-wachtwoord) voor de
# gluetun-VPN-sidecar. Ophalen via:
#   https://my.nordaccount.com/dashboard/nordvpn/manual-configuration/
#   -> "Set up NordVPN manually" -> "Service credentials"
# BELANGRIJK: prowlarr en decypharr draaien via gluetun (network_mode:
# service:gluetun) en starten pas als gluetun gezond is -- zonder geldige
# waarden hier blijft de hele stack hangen. Zie README.md.
NORDVPN_OPENVPN_USER=
NORDVPN_OPENVPN_PASSWORD=
NORDVPN_COUNTRY=Netherlands
