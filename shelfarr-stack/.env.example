# ==============================================================================
# Shelfarr — Raspberry Pi
# Kopieer naar .env (`cp .env.example .env`) en pas de paden aan.
# ==============================================================================

# --- Versie ------------------------------------------------------------------
# Vastzetten is verstandig: `latest` kan tijdens een pull zomaar een breaking
# change binnenhalen. Nieuwere versies: github.com/Pedro-Revez-Silva/shelfarr/releases
# (release vYYYY.MM.DD.N -> hier YYYY.MM.DD.N invullen, zónder de v).
SHELFARR_VERSION=2026.08.24.1

# --- Architectuur ------------------------------------------------------------
# De Pi draait een 64-bit kernel met 32-bit userland, dus Docker zou uit zichzelf
# armv7-images pullen. Die bestaan niet voor Shelfarr. Deze regel dwingt arm64 af.
# Op een volledig 64-bit systeem mag hij blijven staan; hij is daar een no-op.
DOCKER_PLATFORM=linux/arm64

# --- Gebruiker & tijdzone ----------------------------------------------------
# `id -u` en `id -g` op je Pi. Standaardgebruiker (pi) is meestal 1000:1000.
PUID=1000
PGID=1000
TZ=Europe/Amsterdam

# --- Paden -------------------------------------------------------------------
# Zet DATA_PATH op een externe SSD/HDD, niet op de SD-kaart: de SQLite-database
# schrijft continu en dat sloopt SD-kaarten.
DATA_PATH=/mnt/ssd/shelfarr/data

# Waar Shelfarr afgeronde boeken neerzet. Wijs dit in de map aan die je
# Dropbox-timer synct, dan lopen Shelfarr-boeken automatisch mee.
AUDIOBOOKS_PATH=/mnt/ssd/media/audiobooks
EBOOKS_PATH=/mnt/ssd/media/ebooks

# Decypharr's downloadmap, op hetzelfde containerpad als Bookshelf hem ziet.
# Hier zoekt Shelfarr per category, dus in <pad>/shelfarr.
# make-env.sh leest deze uit de draaiende Bookshelf-container.
DOWNLOADS_PATH=/home/jspr/Jasperdeveer/readarr-raspberrypi-setup/config/decypharr/downloads
DOWNLOADS_CONTAINER_PATH=/app/downloads
DOWNLOADS_MOUNT_OPTS=ro,rslave

# De rclone-mount van Torbox: het doel van Decypharr's symlinks. Ook hier moet
# het containerpad gelijk zijn aan wat Bookshelf gebruikt, anders wijzen die
# symlinks binnen Shelfarr nergens heen.
TORBOX_HOST_PATH=/mnt/torbox
TORBOX_CONTAINER_PATH=/torbox

# --- Netwerk -----------------------------------------------------------------
# Poort op de Pi waarop de web-UI luistert.
SHELFARR_PORT=5056
# 0.0.0.0 = bereikbaar op je LAN én via Tailscale.
# 127.0.0.1 = alleen via `tailscale serve` (aanrader, zie README).
BIND_ADDRESS=0.0.0.0
# Interne poort in de container. Alleen aanpassen bij een conflict (bv. gluetun).
HTTP_PORT=80

# Het bestaande Docker-netwerk van gluetun. Prowlarr en Decypharr delen gluetun's
# netwerk-namespace, dus binnen dit netwerk heten ze allebei `gluetun`.
ARR_NETWORK=readarr-raspberrypi-setup_default

# Laat `docker compose up -d` automatisch de netwerk-override meenemen.
COMPOSE_FILE=docker-compose.yml:docker-compose.arr-network.yml

# --- Optionele profielen -----------------------------------------------------
# Audiobookshelf (--profile audiobookshelf)
AUDIOBOOKSHELF_PORT=13378
AUDIOBOOKSHELF_CONFIG_PATH=/mnt/ssd/audiobookshelf/config
AUDIOBOOKSHELF_METADATA_PATH=/mnt/ssd/audiobookshelf/metadata

# FlareSolverr (--profile flaresolverr)
FLARESOLVERR_LOG_LEVEL=info

# Audible Backup / Libation (--profile audible)
# Laat leeg voor een Docker-volume, of geef een hostpad op voor grote libraries.
# LIBATION_BOOKS_PATH=/mnt/ssd/media/audible

# --- Overig ------------------------------------------------------------------
# auto (standaard) | always | never — zet op `never` als Shelfarr bij het
# starten klaagt dat het eigenaarschap van een mount niet aangepast kan worden.
CHOWN_ON_START=auto
