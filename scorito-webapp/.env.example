# Scorito inloggegevens worden NIET hier opgeslagen — vul ze in via de webapp.

# The Odds API — gratis key aanmaken op https://the-odds-api.com/
# Gratis tier: 500 verzoeken/maand
ODDS_API_KEY=jouw_odds_api_key_hier

# football-data.org — gratis key aanmaken op https://www.football-data.org/client/register
# Gratis tier: 10 verzoeken/min, inclusief WK-data
FOOTBALL_DATA_API_KEY=jouw_football_data_key_hier

# PIN-beveiliging voor de app (aanbevolen als de app publiek bereikbaar is, bv. via Railway)
# Laat leeg om PIN-beveiliging uit te schakelen (voor lokaal gebruik)
APP_PIN=

# Sessie-beveiliging (verander dit naar een willekeurige string!)
SESSION_SECRET=verander-dit-naar-een-willekeurige-reeks

# Poort (standaard: 3000)
PORT=3000

# Chromium pad (optioneel — laat leeg voor automatische detectie)
# CHROMIUM_PATH=/usr/bin/chromium-browser
